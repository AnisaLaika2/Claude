# ── AI (opzionale) ──────────────────────────────────────────
# Chiave Anthropic per ricette e assistente basati su Claude.
# Senza chiave l'app usa un motore euristico integrato (funziona comunque).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Supabase (opzionale, per sync cloud e famiglia realtime) ─
# L'app è offline-first e funziona senza. Vedi supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
